{
  "name": "datalab-web-showcase",
  "version": "0.1.0",
  "private": true,
  "description": "Unattended live demos of DataLab Web: a static host page that embeds DataLab Web in a same-origin iframe and plays scripted demos on top of it",
  "license": "BSD-3-Clause",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "serve": "node scripts/serve.mjs",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,js,mjs,cjs,css,html,md,json,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,js,mjs,cjs,css,html,md,json,yml}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "i18n:check": "node scripts/i18n-check.mjs",
    "showcase:check": "playwright test --project=showcase-check",
    "showcase:headed": "playwright test --project=showcase-headed"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "~1.64.0",
    "@types/node": "^26.6.5",
    "eslint": "^10.12.0",
    "fake-indexeddb": "^6.2.8",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^6.4.4",
    "vitest": "^5.0.4"
  }
}
