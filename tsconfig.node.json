{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "strict": true,
    "noEmit": true,
    "types": ["node", "vite/client"]
  },
  "include": [
    "vite.config.ts",
    "playwright.config.ts",
    "tests/unit",
    "tests/e2e"
  ]
}
